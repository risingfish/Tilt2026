{
  "manifest_version": 3,
  "name": "Tilt",
  "version": "0.1.0",
  "description": "3D WebGL visualization of the inspected page's DOM, as a DevTools panel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tilt@mozilla.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "devtools_page": "devtools.html",
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
